{
  "name": "md22-renderer",
  "version": "1.0.0",
  "private": true,
  "description": "Pinned local renderer assets for the MD22 macOS application",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "build:renderer": "node scripts/build-renderer.mjs",
    "audit:dependencies": "node scripts/audit-dependencies.mjs && npm audit --audit-level=high",
    "sbom": "node scripts/generate-sbom.mjs"
  },
  "dependencies": {
    "dompurify": "3.4.14",
    "highlight.js": "11.12.0",
    "katex": "0.18.5",
    "markdown-it": "15.0.1",
    "markdown-it-anchor": "9.2.1",
    "markdown-it-container": "4.0.0",
    "markdown-it-footnote": "4.0.0",
    "markdown-it-task-lists": "2.1.1",
    "markdown-it-texmath": "1.0.0",
    "mermaid": "11.17.2"
  },
  "devDependencies": {
    "esbuild": "0.28.2"
  },
  "engines": {
    "node": ">=22"
  }
}
